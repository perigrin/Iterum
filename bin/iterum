#!/usr/bin/env perl
use 5.40.0;
use utf8;
use FindBin;
use lib "$FindBin::Bin/../lib";
use experimental 'try';

# Set up UTF-8 handling
binmode(STDOUT, ":utf8");

# Import required modules
use Iterum::ECS;
use Iterum::Entities::Player;
use Iterum::Entities::Enemies::Goblin;
use Iterum::Entities::Enemies::GiantRat;
use Iterum::Systems::Combat;
use Iterum::Systems::EVScoring;
use Iterum::UI::CLI;
use Iterum::UI::GameScreens;

# Game states
use constant {
    STATE_MAIN_MENU => 'main_menu',
    STATE_START  => 'start',
    STATE_COMBAT => 'combat',
    STATE_END    => 'end',
};

# Player actions
use constant {
    ACTION_ATTACK => 'attack',
    ACTION_DEFEND => 'defend',
    ACTION_QUIT   => 'quit',
    ACTION_HELP   => 'help',
};

# Initialize game state
my $game_state = {
    running       => 1,
    current_state => STATE_MAIN_MENU,
    player        => undef,
    enemy         => undef,
    ecs           => undef,
    systems       => [],
    cli           => undef,
    turn          => 0,
    message       => '',
    show_help     => 0,
    version       => '1.0.0',
    dungeon_level => 1,
    outcome       => '',
};

# Initialize ECS and entities
sub initialize_game($state) {
    # Determine enemy type based on dungeon level
    my $enemy_type = ($state->{dungeon_level} % 2 == 0) ? 'rat' : 'goblin';

    try {
        # Create ECS
        $state->{ecs} = Iterum::ECS->new();

        # Create player
        $state->{player} =
          Iterum::Entities::Player->new( ecs => $state->{ecs} );

        # Set up the player components
        $state->{player}->setup();

        # Create enemy based on type
        if ($enemy_type eq 'rat') {
            $state->{enemy} = Iterum::Entities::Enemies::GiantRat->new( ecs => $state->{ecs} );
            $state->{enemy_type} = 'Giant Rat';
        } else {
            $state->{enemy} = Iterum::Entities::Enemies::Goblin->new( ecs => $state->{ecs} );
            $state->{enemy_type} = 'Goblin';
        }

        # Set up the enemy components
        $state->{enemy}->setup();

        # Create systems
        my $combat_system =
          Iterum::Systems::Combat->new( ecs => $state->{ecs} );
        my $ev_system = Iterum::Systems::EVScoring->new( ecs => $state->{ecs} );

        $state->{systems} = [ $combat_system, $ev_system ];

        # Add systems to ECS
        $state->{ecs}->add_system($_) for @{ $state->{systems} };

        # Start combat between player and enemy
        $combat_system->start_combat(
            $state->{player}->id,
            $state->{enemy}->id
        );

        # Initialize CLI
        $state->{cli} = Iterum::UI::CLI->new();

        # Initialize GameScreens
        $state->{game_screens} = Iterum::UI::GameScreens->new(cli => $state->{cli});
    }
    catch ($e) {
        die "Failed to initialize game: $e";
    };

    return $state;
}

# Display help screen
sub display_help($state) {
    # Use the enhanced help screen from GameScreens
    $state->{game_screens}->display_help_screen();
}

# Process main menu state
sub process_main_menu($state) {
    # Display start screen with enhanced UI
    $state->{game_screens}->display_start_screen($state->{version});

    # Transition to start state to set up the game
    $state->{current_state} = STATE_START;
}

# Process start state
sub process_start_state($state) {
    # Initialize or reset the game
    initialize_game($state);

    # Display encounter message with dungeon level information
    $state->{cli}->clear_screen();
    $state->{cli}->display_header("Dungeon Level " . $state->{dungeon_level});
    $state->{cli}->display_message("You encounter a " . $state->{enemy_type} . "!");
    $state->{cli}->prompt_continue();

    # Transition to combat state
    $state->{current_state} = STATE_COMBAT;
}

# Process combat state
sub process_combat_state($state) {

    # Check if we should show help
    if ( $state->{show_help} ) {
        display_help($state);
        $state->{show_help} = 0;
        return;
    }

    # Display game state
    $state->{cli}->clear_screen();
    $state->{cli}->display_title( "Iterum - Level " . $state->{dungeon_level} . " - Turn " . $state->{turn} );

    # Display player and enemy status
    my $player_status = $state->{player}->get_status();
    my $enemy_status  = $state->{enemy}->get_status();

    $state->{cli}->display_entity_status($player_status);
    $state->{cli}->display_entity_status($enemy_status);

    # Display EV score
    $state->{game_screens}->display_ev_stats(
        $state->{player}->id,
        $state->{systems}[1] # EV system
    );

    # Display message if any
    $state->{cli}->display_message( $state->{message} ) if $state->{message};
    $state->{message} = '';

    # Get player action
    my $action = lc( $state->{cli}->get_combat_action() );

    # Process player action
    my $combat_system = $state->{systems}[0];    # Combat system
    my $ev_system     = $state->{systems}[1];    # EV scoring system

    if ( $action eq 'attack' || $action eq ACTION_ATTACK ) {
        $combat_system->set_target( $state->{player}->id, $state->{enemy}->id );
        $combat_system->set_action( $state->{player}->id, 'attack' );
        $combat_system->process_attack( $state->{player}->id );

        my $hit = $combat_system->last_hit( $state->{player}->id );
        my $damage = $combat_system->last_damage( $state->{player}->id );

        $state->{message} = "You attacked the " . $enemy_status->{name} . "!";
        if ( $hit ) {
            $state->{message} .=
              " You hit for " . $damage . " damage!";
        }
        else {
            $state->{message} .= " You missed!";
        }

        # Score the player's decision
        $ev_system->record_decision( $state->{player}->id,
            $state->{enemy}->id, 'attack' );
    }
    elsif ( $action eq 'defend' || $action eq ACTION_DEFEND ) {
        $state->{player}->defend();
        $state->{message} = "You prepare to defend!";

        # Score the player's decision
        $ev_system->record_decision( $state->{player}->id,
            $state->{enemy}->id, 'defend' );
    }
    elsif ( $action eq 'help' || $action eq ACTION_HELP ) {
        $state->{show_help} = 1;
        return;
    }
    elsif ( $action eq 'quit' || $action eq ACTION_QUIT ) {
        $state->{current_state} = STATE_END;
        $state->{message}       = "You decided to quit the game.";
        $state->{outcome}       = 'quit';
        return;
    }
    elsif ( $action eq 'use_item' || $action eq 'i' ) {
        # Simple healing implementation
        my $heal_amount = 20;
        my $previous_hp = $player_status->{health}{current_hp};
        my $max_hp = $player_status->{health}{max_hp};

        if ($previous_hp < $max_hp) {
            # Heal player
            my ($health) = $state->{ecs}->get_components($state->{player}->id, 'Health');
            $health->{current_hp} += $heal_amount;
            if ($health->{current_hp} > $health->{max_hp}) {
                $health->{current_hp} = $health->{max_hp};
            }
            $state->{ecs}->add_component($state->{player}->id, 'Health', $health);

            $state->{message} = "You used a healing potion and recovered $heal_amount HP.";
        } else {
            $state->{message} = "You are already at full health!";
        }

        # Score the player's decision
        $ev_system->record_decision($state->{player}->id, $state->{enemy}->id, 'use_item');
    }
    elsif ( $action eq 'flee' || $action eq 'f' ) {
        # 50% chance to flee successfully
        if (rand() < 0.5) {
            $state->{message} = "You successfully fled from the " . $enemy_status->{name} . "!";
            $state->{current_state} = STATE_END;
            $state->{outcome} = 'fled';
            return;
        } else {
            $state->{message} = "You failed to flee from the " . $enemy_status->{name} . "!";
        }

        # Score the player's decision
        $ev_system->record_decision($state->{player}->id, $state->{enemy}->id, 'flee');
    }
    else {
        $state->{message} =
          "Invalid action. Try 'attack', 'defend', 'use_item', 'flee', 'help', or 'quit'.";
        return;
    }

    # Process enemy turn if player is still alive
    my ($player_health) =
      $state->{ecs}->get_components( $state->{player}->id, 'Health' );
    if ( $player_health->{current_hp} > 0 ) {
        # Have the enemy make a decision and act
        my $enemy_action = $state->{enemy}->process_turn($combat_system, $state->{player}->id);

        $state->{message} .=
          "\nThe " . $enemy_status->{name} . " $enemy_action!";
    }

    # Check if combat has ended
    ($player_health) =
      $state->{ecs}->get_components( $state->{player}->id, 'Health' );
    my ($enemy_health) =
      $state->{ecs}->get_components( $state->{enemy}->id, 'Health' );

    if ( $player_health->{current_hp} <= 0 ) {
        $state->{message} .= "\nYou have been defeated!";
        $state->{current_state} = STATE_END;
        $state->{outcome} = 'defeat';
    }
    elsif ( $enemy_health->{current_hp} <= 0 ) {
        $state->{message} .=
          "\nYou have defeated the " . $enemy_status->{name} . "!";
        $state->{current_state} = STATE_END;
        $state->{outcome} = 'victory';
    }

    # Increment turn counter
    $state->{turn}++;

    # Log the current EV score if available
    my $stats = $ev_system->get_decision_stats( $state->{player}->id );
    if ($stats && $stats->{overall_avg}) {
        $state->{cli}->display_message("Current EV score: " . $stats->{overall_avg}, 'green');
    }
}

# Process end state
sub process_end_state($state) {
    my $ev_system = $state->{systems}[1];    # EV scoring system

    # Display appropriate end screen based on outcome
    if ($state->{outcome} eq 'victory') {
        # Show victory screen with EV analysis
        $state->{game_screens}->display_victory_screen(
            $state->{player}->get_status(),
            $state->{enemy_type},
            $ev_system
        );

        # Increment dungeon level for next game
        $state->{dungeon_level}++;
    }
    elsif ($state->{outcome} eq 'defeat') {
        # Show defeat screen with EV analysis
        $state->{game_screens}->display_defeat_screen(
            $state->{player}->get_status(),
            $state->{enemy_type},
            $ev_system
        );

        # Reset dungeon level for next game
        $state->{dungeon_level} = 1;
    }
    elsif ($state->{outcome} eq 'fled') {
        # Show fled message
        $state->{cli}->clear_screen();
        $state->{cli}->display_title("Escaped!");
        $state->{cli}->display_text("You escaped from the dungeon and live to fight another day.");
        $state->{cli}->display_text("However, you didn't earn any rewards or experience.");
        $state->{cli}->prompt_continue();

        # Don't change dungeon level
    }
    else {
        # Default end screen (quit or other)
        $state->{cli}->clear_screen();
        $state->{cli}->display_title("Game Over");
        $state->{cli}->display_text($state->{message});

        # Show EV score if available
        my $stats = $ev_system->get_decision_stats($state->{player}->id);
        if ($stats && $stats->{overall_avg}) {
            $state->{cli}->display_text("\nFinal EV Score: " . $stats->{overall_avg});
            $state->{cli}->display_text("\nAI Coach Feedback: " .
                $ev_system->generate_feedback($state->{player}->id));
        }

        $state->{cli}->prompt_continue();
    }

    # Ask to play again using enhanced UI
    my $choice = $state->{game_screens}->play_again_prompt();

    if ($choice eq 'y') {
        # Start a new game
        $state->{current_state} = STATE_START;
        $state->{turn} = 0;
        $state->{message} = '';
        $state->{show_help} = 0;
        $state->{outcome} = '';
    }
    elsif ($choice eq 'c') {
        # Show credits then return to this screen
        $state->{game_screens}->display_credits();
        process_end_state($state);
    }
    else {
        # End the game
        $state->{running} = 0;
    }
}

# Main game loop
sub main_loop($state) {

    while ( $state->{running} ) {
        try {
            if ( $state->{current_state} eq STATE_MAIN_MENU ) {
                process_main_menu($state);
            }
            elsif ( $state->{current_state} eq STATE_START ) {
                process_start_state($state);
            }
            elsif ( $state->{current_state} eq STATE_COMBAT ) {
                process_combat_state($state);
            }
            elsif ( $state->{current_state} eq STATE_END ) {
                process_end_state($state);
            }
            else {
                die "Invalid game state: " . $state->{current_state};
            }

            # Update ECS systems
            $state->{ecs}->update() if $state->{ecs};
        }
        catch ($e) {

            # Handle any errors
            $state->{cli}->clear_screen();
            $state->{cli}->display_title("Error");
            $state->{cli}->display_text("An error occurred: $e");
            $state->{cli}->display_text("\nPress any key to exit...");
            $state->{cli}->get_input();
            $state->{running} = 0;
        };
    }
}

# Initialize and run the game
try {
    # Create CLI first so we can use it for initialization feedback
    $game_state->{cli} = Iterum::UI::CLI->new();
    $game_state->{game_screens} = Iterum::UI::GameScreens->new(cli => $game_state->{cli});

    main_loop($game_state);

    # Clean up and exit
    $game_state->{cli}->cleanup();
    say "Thanks for playing Iterum!";
}
catch ($e) {
    say "Critical error: $e";
}
finally {
    exec('stty sane');
    exit 0;
};
